<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bounce Forward Billing Portal</title>
    <link rel="icon" type="image/jpeg" href="/images/favicon.jpg">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-4Q6Gf2aSP4eDXB8Miphtr37CMZZQ5oXLH2yaXMJ2w8e2ZtHTl7GptT4jmndRuHDT" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="bg-super-light-pink d-flex flex-column min-vh-100">
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" href="#">
                <img src="/images/logo.png" 
                     alt="Bounce Forward Logo" 
                     class="me-2"
                     style="height: 40px; width: auto;">
                <!-- <span class="d-none d-sm-inline">Bounce Forward Billing</span>
                <span class="d-inline d-sm-none">Billing</span> -->
            </a>
            <div class="navbar-nav ms-auto">
                <div class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="d-flex align-items-center">
                            <div class="bg-profile-circle rounded-circle p-1 me-2">
                                <i class="bi bi-person text-slate-600"></i>
                            </div>
                            <span class="text-slate-700"><%= email %></span>
                        </div>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><h6 class="dropdown-header text-slate-600">Account</h6></li>
                        <li><span class="dropdown-item-text small text-slate-500"><%= email %></span></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-red-600 d-flex align-items-center" href="/logout">
                            <i class="bi bi-box-arrow-right me-2"></i>
                            Logout
                        </a></li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="container my-5 flex-grow-1">
        <!-- Header -->
        <div class="mb-5">
            <h1 class="h3 fw-bold text-slate-900 mb-1">Billing Overview</h1>
            <p class="text-slate-500 mb-0">Manage your subscription and view invoice history</p>
        </div>

        <!-- Error Alert -->
        <% if (error) { %>
            <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <div><%= error %></div>
            </div>
        <% } %>

        <!-- Account Status Section -->
        <% if (!error && customer) { %>
            <!-- Account Status Hero -->
            <div class="mb-5 rounded-4">
                <div>
                    <!-- Status Grid -->
                    <div class="row g-4">
                        <!-- Current Subscription -->
                        <% if (subscriptions && subscriptions.length > 0) { %>
                            <% subscriptions.forEach(function(subscription, index) { %>
                                <div class="col-md-6 col-lg-4">
                                    <div class="bg-white rounded-3 p-4 h-100 border border-slate-200">
                                        <div class="d-flex align-items-start justify-content-between mb-3">
                                            <div class="d-flex align-items-center">
                                                <div class="bg-blue-50 rounded-circle p-2 me-3">
                                                    <i class="bi bi-layers text-blue-600"></i>
                                                </div>
                                                <div>
                                                    <h6 class="fw-bold text-slate-900 mb-0">Current Plan</h6>
                                                    <small class="text-slate-500">Active subscription</small>
                                                </div>
                                            </div>
                                            <span class="badge <%= subscription.status === 'active' ? 'bg-success' : subscription.status === 'canceled' ? 'bg-danger' : subscription.status === 'past_due' ? 'bg-warning text-dark' : 'bg-secondary' %> rounded-pill">
                                                <%= subscription.status.charAt(0).toUpperCase() + subscription.status.slice(1) %>
                                            </span>
                                        </div>
                                        
                                        <div class="mb-3">
                                            <h5 class="fw-bold text-slate-900 mb-1">
                                                <%= subscription.items.data[0].price.product.name %>
                                            </h5>
                                            <div class="text-slate-600 fw-medium">
                                                <%= (subscription.items.data[0].price.unit_amount / 100).toLocaleString('en-US', { 
                                                    style: 'currency', 
                                                    currency: subscription.items.data[0].price.currency.toUpperCase() 
                                                }) %>
                                                <span class="text-slate-500">/ <%= subscription.items.data[0].price.recurring.interval %></span>
                                            </div>
                                        </div>

                                        <div class="border-top pt-3">
                                            <div class="row g-2 small text-slate-600">
                                                <div class="col-12">
                                                    <strong class="text-slate-700">Billing Period:</strong><br>
                                                    <%= new Date(subscription.current_period_start * 1000).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %> - 
                                                    <%= new Date(subscription.current_period_end * 1000).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                                                </div>
                                                <% if (subscription.status === 'active') { %>
                                                    <div class="col-12 mt-2">
                                                        <strong class="text-slate-700">Next Billing:</strong><br>
                                                        <%= new Date(subscription.current_period_end * 1000).toLocaleDateString('en-US', { 
                                                            weekday: 'long',
                                                            year: 'numeric', 
                                                            month: 'long', 
                                                            day: 'numeric' 
                                                        }) %>
                                                    </div>
                                                <% } else if (subscription.status === 'canceled' && subscription.canceled_at) { %>
                                                    <div class="col-12 mt-2">
                                                        <strong class="text-slate-700">Canceled:</strong><br>
                                                        <%= new Date(subscription.canceled_at * 1000).toLocaleDateString('en-US', { 
                                                            year: 'numeric', 
                                                            month: 'long', 
                                                            day: 'numeric' 
                                                        }) %>
                                                    </div>
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% }); %>
                        <% } %>

                        <!-- Upcoming Invoice -->
                        <% if (upcomingInvoice) { %>
                            <%
                            // Calculate days until due
                            const dueDate = new Date(upcomingInvoice.period_end * 1000);
                            const today = new Date();
                            const daysUntilDue = Math.ceil((dueDate - today) / (1000 * 60 * 60 * 24));
                            
                            // Determine badge based on days until due
                            let badgeClass = '';
                            let badgeText = '';
                            
                            if (daysUntilDue <= 7) {
                                badgeClass = 'bg-red-100 text-red-700';
                                badgeText = 'Due Soon';
                            } else if (daysUntilDue <= 14) {
                                badgeClass = 'bg-yellow-100 text-yellow-700';
                                badgeText = 'Due Soon';
                            } else if (daysUntilDue <= 30) {
                                badgeClass = 'bg-blue-100 text-blue-700';
                                badgeText = 'Upcoming';
                            } else {
                                badgeClass = 'bg-slate-100 text-slate-600';
                                badgeText = 'Scheduled';
                            }
                            %>
                            <div class="col-md-6 col-lg-4">
                                <div class="bg-white rounded-3 p-4 h-100 border border-slate-200">
                                    <div class="d-flex align-items-start justify-content-between mb-3">
                                        <div class="d-flex align-items-center">
                                            <div class="bg-yellow-50 rounded-circle p-2 me-3">
                                                <i class="bi bi-calendar-event text-yellow-600"></i>
                                            </div>
                                            <div>
                                                <h6 class="fw-bold text-slate-900 mb-0">Next Invoice</h6>
                                                <small class="text-slate-500">
                                                    <%= daysUntilDue === 1 ? 'Tomorrow' : 
                                                        daysUntilDue === 0 ? 'Today' : 
                                                        daysUntilDue < 0 ? 'Overdue' :
                                                        `In ${daysUntilDue} day${daysUntilDue !== 1 ? 's' : ''}` %>
                                                </small>
                                            </div>
                                        </div>
                                        <span class="badge <%= badgeClass %> rounded-pill"><%= badgeText %></span>
                                    </div>
                                    
                                    <div class="border-top pt-3">
                                        <div class="mb-3">
                                            <h5 class="fw-bold text-slate-900 mb-1">
                                                <%= (upcomingInvoice.amount_due / 100).toLocaleString('en-US', { 
                                                    style: 'currency', 
                                                    currency: upcomingInvoice.currency.toUpperCase() 
                                                }) %>
                                                <% if (upcomingInvoice.tax && upcomingInvoice.tax > 0) { %>
                                                    <small class="text-slate-500 fw-normal" style="font-size: 0.7rem; margin-left: 0.25rem;">incl. tax</small>
                                                <% } %>
                                            </h5>
                                            <div class="text-slate-600">
                                                Due <%= new Date(upcomingInvoice.period_end * 1000).toLocaleDateString('en-US', { 
                                                    month: 'long', 
                                                    day: 'numeric',
                                                    year: 'numeric'
                                                }) %>
                                            </div>
                                        </div>

                                        <% if (upcomingInvoice.lines && upcomingInvoice.lines.data.length > 0) { %>
                                            <div>
                                                <div class="small text-slate-600">
                                                    <strong class="text-slate-700">Items:</strong><br>
                                                    <% upcomingInvoice.lines.data.slice(0, 2).forEach(function(line) { %>
                                                        <div class="text-slate-600"><%= line.description %></div>
                                                    <% }); %>
                                                    <% if (upcomingInvoice.lines.data.length > 2) { %>
                                                        <div class="text-slate-500">+ <%= upcomingInvoice.lines.data.length - 2 %> more item<%= upcomingInvoice.lines.data.length - 2 !== 1 ? 's' : '' %></div>
                                                    <% } %>
                                                </div>
                                            </div>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        <% } %>

                        <!-- Payment Methods -->
                        <% if (paymentMethods && paymentMethods.length > 0) { %>
                            <div class="col-md-6 col-lg-4">
                                <div class="bg-white rounded-3 p-4 h-100 border border-slate-200">
                                    <div class="d-flex align-items-center mb-3">
                                        <div class="bg-green-50 rounded-circle p-2 me-3">
                                            <i class="bi bi-credit-card text-green-600"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold text-slate-900 mb-0">Payment Methods</h6>
                                            <small class="text-slate-500"><%= paymentMethods.length %> card<%= paymentMethods.length !== 1 ? 's' : '' %> on file</small>
                                        </div>
                                    </div>
                                    
                                    <div class="border-top pt-3">
                                        <div class="space-y-3">
                                        <% paymentMethods.slice(0, 2).forEach(function(pm, index) { %>
                                            <div class="<%= index !== 0 ? 'mt-3 pt-3 border-top border-slate-100' : '' %>">
                                                <div class="d-flex align-items-start">
                                                    <div class="me-3">
                                                        <i class="bi bi-credit-card-2-front text-slate-400" style="font-size: 1.25rem;"></i>
                                                    </div>
                                                    <div class="flex-grow-1">
                                                        <div class="d-flex align-items-center justify-content-between mb-1">
                                                            <div class="fw-medium text-slate-900">
                                                                •••• •••• •••• <%= pm.card.last4 %>
                                                            </div>
                                                            <% if (index === 0) { %>
                                                                <span class="badge bg-blue-100 text-blue-700 rounded-pill" style="font-size: 0.7rem;">Primary</span>
                                                            <% } %>
                                                        </div>
                                                        <div class="small text-slate-500 mb-1">
                                                            <%= pm.card.brand.charAt(0).toUpperCase() + pm.card.brand.slice(1) %>
                                                            <% if (pm.card.funding && pm.card.funding !== 'unknown') { %>
                                                                <%= pm.card.funding.charAt(0).toUpperCase() + pm.card.funding.slice(1) %>
                                                            <% } %>
                                                            • Exp <%= pm.card.exp_month %>/<%= pm.card.exp_year %>
                                                        </div>
                                                        <div class="small text-slate-400">
                                                            <% if (pm.card.country) { %>
                                                                <i class="bi bi-geo-alt me-1"></i><%= pm.card.country.toUpperCase() %>
                                                            <% } %>
                                                            <% if (pm.created) { %>
                                                                <span class="ms-2">
                                                                    <i class="bi bi-calendar-plus me-1"></i>Added <%= new Date(pm.created * 1000).toLocaleDateString('en-US', { month: 'short', year: 'numeric' }) %>
                                                                </span>
                                                            <% } %>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        <% }); %>
                                        <% if (paymentMethods.length > 2) { %>
                                            <div class="text-center pt-3 border-top border-slate-100">
                                                <small class="text-slate-500">+ <%= paymentMethods.length - 2 %> more card<%= paymentMethods.length - 2 !== 1 ? 's' : '' %></small>
                                            </div>
                                        <% } %>
                                        </div>

                                        <% if (customerPortalUrl) { %>
                                            <div class="border-top pt-3 mt-3">
                                                <a href="<%= customerPortalUrl %>" class="btn btn-outline-primary btn-sm w-100">
                                                    <i class="bi bi-pencil-square me-2"></i>
                                                    Manage Payment Methods
                                                </a>
                                            </div>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        <% } %>

                        <!-- Account Summary -->
                        <div class="col-md-12 col-lg-4">
                            <div class="bg-white rounded-3 p-4 h-100 border border-slate-200">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="bg-purple-50 rounded-circle p-2 me-3">
                                        <i class="bi bi-graph-up text-purple-600"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold text-slate-900 mb-0">Account Summary</h6>
                                        <small class="text-slate-500">Your account overview</small>
                                    </div>
                                </div>
                                
                                <div class="border-top pt-3">
                                    <div class="row g-2 small text-slate-600">
                                        <div class="col-6 col-md-3 col-lg-6">
                                            <strong class="text-slate-700">Customer Since:</strong><br>
                                            <%= new Date(customer.created * 1000).toLocaleDateString('en-US', { 
                                                year: 'numeric', 
                                                month: 'long', 
                                                day: 'numeric' 
                                            }) %>
                                        </div>
                                        <% 
                                        const outstandingBalance = invoices.reduce((sum, invoice) => {
                                            if (invoice.status === 'open' || invoice.status === 'past_due') {
                                                return sum + invoice.amount_due;
                                            }
                                            return sum;
                                        }, 0);
                                        const lastPayment = invoices.find(invoice => invoice.status === 'paid');
                                        %>
                                        <div class="col-6 col-md-3 col-lg-6 mt-2">
                                            <strong class="text-slate-700">Outstanding Balance:</strong><br>
                                            <span class="<%= outstandingBalance > 0 ? 'text-yellow-600' : 'text-green-600' %>">
                                                <%= (outstandingBalance / 100).toLocaleString('en-US', { 
                                                    style: 'currency', 
                                                    currency: invoices.length > 0 ? invoices[0].currency.toUpperCase() : 'USD' 
                                                }) %>
                                            </span>
                                        </div>
                                        <div class="col-6 col-md-3 col-lg-6 mt-2">
                                            <strong class="text-slate-700">Invoices:</strong><br>
                                            <%= invoices.length %> total
                                            <% if (invoices.length > 1) { %>
                                                <i class="bi bi-download text-slate-500 ms-1" 
                                                   onclick="downloadAllInvoices()" 
                                                   title="Download all invoices as ZIP"
                                                   style="cursor: pointer; font-size: inherit;"
                                                   onmouseover="this.style.color='#C18D85'" 
                                                   onmouseout="this.style.color='#64748b'"></i>
                                            <% } %>
                                        </div>
                                        <% if (lastPayment) { %>
                                            <div class="col-6 col-md-3 col-lg-6 mt-2">
                                                <strong class="text-slate-700">Last Payment:</strong><br>
                                                <%= new Date(lastPayment.status_transitions.paid_at * 1000).toLocaleDateString('en-US', { 
                                                    month: 'short', 
                                                    day: 'numeric',
                                                    year: 'numeric'
                                                }) %>
                                            </div>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        <% } %>

        <!-- Invoices Section -->
        <% if (invoices && invoices.length > 0) { %>
            <!-- Invoice List -->
            <div class="card rounded-4 shadow-tailwind">
                <div class="card-header bg-white border-bottom rounded-top-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="mb-0 text-slate-900 fw-semibold">Recent Invoices</h5>
                            <small class="text-slate-500">Your billing history and receipts</small>
                        </div>
                        <% if (invoices.length > 1) { %>
                            <button class="btn btn-outline-primary btn-sm d-flex align-items-center" onclick="downloadAllInvoices()">
                                <i class="bi bi-download me-1"></i>
                                <span class="d-none d-sm-inline">Download All</span>
                                <span class="d-inline d-sm-none">All</span>
                            </button>
                        <% } %>
                    </div>
                </div>

                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        <% invoices.forEach(function(invoice, index) { %>
                            <div class="list-group-item border-0 <%= index !== invoices.length - 1 ? 'border-bottom' : '' %> py-4 <%= index === invoices.length - 1 ? 'rounded-bottom-4' : '' %> invoice-item">
                                <!-- Desktop Layout -->
                                <div class="d-none d-md-block">
                                    <div class="row align-items-center">
                                        <div class="col-md-1">
                                            <div class="status-indicator <%= invoice.status %>"></div>
                                        </div>
                                        
                                        <div class="col-md-3">
                                            <div class="d-flex flex-column">
                                                <span class="fw-semibold text-slate-900">
                                                    <%= (invoice.amount_paid / 100).toLocaleString('en-US', { 
                                                        style: 'currency', 
                                                        currency: invoice.currency.toUpperCase() 
                                                    }) %>
                                                </span>
                                                <% if (invoice.number) { %>
                                                    <small class="text-slate-500">Invoice #<%= invoice.number %></small>
                                                <% } %>
                                            </div>
                                        </div>
                                        
                                        <div class="col-md-4">
                                            <div class="d-flex flex-column">
                                                <span class="text-slate-700 fw-medium">
                                                    <%= new Date(invoice.created * 1000).toLocaleDateString('en-US', { 
                                                        year: 'numeric', 
                                                        month: 'short', 
                                                        day: 'numeric' 
                                                    }) %>
                                                </span>
                                                <% 
                                                let productName = null;
                                                if (invoice.lines && invoice.lines.data && invoice.lines.data.length > 0) {
                                                    const lineItem = invoice.lines.data[0];
                                                    if (lineItem.price && lineItem.price.product && lineItem.price.product.name) {
                                                        productName = lineItem.price.product.name;
                                                    } else if (lineItem.description) {
                                                        // Clean up description by removing pricing info and quantity
                                                        productName = lineItem.description
                                                            .replace(/^\d+\s*×\s*/, '') // Remove "1 × " prefix
                                                            .replace(/\s*\(at\s*\$[\d,]+\.?\d*\s*\/\s*\w+\).*$/, '') // Remove "(at $35.00 / month)" and anything after
                                                            .replace(/\s*-\s*\$[\d,]+\.?\d*.*$/, '') // Remove "- $35.00" and anything after
                                                            .trim();
                                                    }
                                                }
                                                %>
                                                <% if (productName) { %>
                                                    <small class="text-slate-500">
                                                        <%= productName.length > 50 ? productName.substring(0, 50) + '...' : productName %>
                                                    </small>
                                                <% } else { %>
                                                    <small class="text-slate-400">No product info</small>
                                                <% } %>
                                            </div>
                                        </div>
                                        
                                        <div class="col-md-2">
                                            <span class="badge <%= invoice.status === 'paid' ? 'bg-success' : invoice.status === 'open' ? 'bg-warning text-dark' : 'bg-secondary' %> rounded-pill">
                                                <%= invoice.status.charAt(0).toUpperCase() + invoice.status.slice(1) %>
                                            </span>
                                        </div>
                                        
                                        <div class="col-md-2 text-end">
                                            <% if (invoice.hosted_invoice_url) { %>
                                                <a href="<%= invoice.hosted_invoice_url %>" 
                                                   target="_blank" 
                                                   rel="noopener noreferrer"
                                                   class="btn btn-primary btn-sm">
                                                    <i class="bi bi-eye me-1"></i>
                                                    View Receipt
                                                </a>
                                            <% } else { %>
                                                <button class="btn btn-outline-secondary btn-sm" disabled>
                                                    <i class="bi bi-file-x me-1"></i>
                                                    N/A
                                                </button>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>

                                <!-- Mobile Layout -->
                                <div class="d-block d-md-none mobile-invoice-item">
                                    <!-- Header: Status and Amount -->
                                    <div class="mobile-header">
                                        <div class="mobile-status-row">
                                            <div class="status-indicator <%= invoice.status %>"></div>
                                            <span class="mobile-status-text">
                                                <%= invoice.status.charAt(0).toUpperCase() + invoice.status.slice(1) %>
                                            </span>
                                        </div>
                                        <div class="mobile-amount-display">
                                            <%= (invoice.amount_paid / 100).toLocaleString('en-US', { 
                                                style: 'currency', 
                                                currency: invoice.currency.toUpperCase() 
                                            }) %>
                                        </div>
                                    </div>

                                    <!-- Details Grid -->
                                    <div class="mobile-details-grid">
                                        <% if (invoice.number) { %>
                                            <div class="mobile-detail-item">
                                                <span class="mobile-detail-label">Invoice</span>
                                                <span class="mobile-detail-value">#<%= invoice.number %></span>
                                            </div>
                                        <% } %>
                                        
                                        <div class="mobile-detail-item">
                                            <span class="mobile-detail-label">Date</span>
                                            <span class="mobile-detail-value">
                                                <%= new Date(invoice.created * 1000).toLocaleDateString('en-US', { 
                                                    year: 'numeric', 
                                                    month: 'short', 
                                                    day: 'numeric' 
                                                }) %>
                                            </span>
                                        </div>
                                        
                                        <% 
                                        let mobileProductName = null;
                                        if (invoice.lines && invoice.lines.data && invoice.lines.data.length > 0) {
                                            const lineItem = invoice.lines.data[0];
                                            if (lineItem.price && lineItem.price.product && lineItem.price.product.name) {
                                                mobileProductName = lineItem.price.product.name;
                                            } else if (lineItem.description) {
                                                // Clean up description by removing pricing info and quantity
                                                mobileProductName = lineItem.description
                                                    .replace(/^\d+\s*×\s*/, '') // Remove "1 × " prefix
                                                    .replace(/\s*\(at\s*\$[\d,]+\.?\d*\s*\/\s*\w+\).*$/, '') // Remove "(at $35.00 / month)" and anything after
                                                    .replace(/\s*-\s*\$[\d,]+\.?\d*.*$/, '') // Remove "- $35.00" and anything after
                                                    .trim();
                                            }
                                        }
                                        %>
                                        <% if (mobileProductName) { %>
                                            <div class="mobile-detail-item mobile-description-item">
                                                <span class="mobile-detail-label">Product</span>
                                                <span class="mobile-detail-value mobile-description-value">
                                                    <%= mobileProductName %>
                                                </span>
                                            </div>
                                        <% } %>
                                    </div>

                                    <!-- Action Button -->
                                    <div class="mobile-action-row">
                                        <% if (invoice.hosted_invoice_url) { %>
                                            <a href="<%= invoice.hosted_invoice_url %>" 
                                               target="_blank" 
                                               rel="noopener noreferrer"
                                               class="mobile-view-btn">
                                                <i class="bi bi-eye"></i>
                                                View Receipt
                                            </a>
                                        <% } else { %>
                                            <button class="mobile-view-btn disabled" disabled>
                                                <i class="bi bi-file-x"></i>
                                                Not Available
                                            </button>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                </div>
            </div>
        <% } else if (!error) { %>
            <!-- Empty State -->
            <div class="text-center py-5">
                <div class="card border-0 shadow-tailwind rounded-4">
                    <div class="card-body empty-state">
                        <i class="bi bi-inbox"></i>
                        <h4 class="text-slate-700 mb-3">No invoices found</h4>
                        <p class="text-slate-500 mb-4">We couldn't find any billing history for <strong><%= email %></strong></p>
                        
                        <div class="alert alert-info border-0 bg-blue-50 text-start d-inline-block">
                            <h6 class="fw-semibold text-blue-700 mb-2">This could mean:</h6>
                            <ul class="mb-0 ps-3 text-blue-600">
                                <li>You haven't made any purchases yet</li>
                                <li>Your billing email differs from your login email</li>
                                <li>Your account isn't set up in our billing system yet</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        <% } %>
    </div>

    <!-- Footer -->
    <footer class="mt-auto py-4 bg-white border-top">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <p class="mb-0 text-slate-500">&copy; <%= new Date().getFullYear() %> Bounce Forward Co.</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <div class="d-flex align-items-center justify-content-md-end">
                        <i class="bi bi-shield-check me-2 text-slate-400"></i>
                        <small class="text-slate-500">Secure • Private • Encrypted</small>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <!-- Download Progress Modal -->
    <div class="modal fade" id="downloadModal" tabindex="-1" aria-labelledby="downloadModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title" id="downloadModalLabel">
                        <i class="bi bi-download me-2 text-primary"></i>
                        Preparing Your Invoice Archive
                    </h5>
                </div>
                <div class="modal-body">
                    <div class="text-center mb-4">
                        <div class="mb-3">
                            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                        <p class="text-slate-600 mb-2" id="downloadStatus">Gathering your invoices...</p>
                        <small class="text-slate-500" id="downloadSubtext">This may take a few moments depending on the number of invoices.</small>
                    </div>
                    
                    <div class="progress mb-3" style="height: 8px;">
                        <div class="progress-bar bg-primary" role="progressbar" style="width: 0%" id="downloadProgress"></div>
                    </div>
                    
                    <div class="d-flex justify-content-between small text-slate-500">
                        <span>Progress</span>
                        <span id="downloadPercent">0%</span>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0" id="downloadFooter" style="display: none;">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js" integrity="sha384-j1CDi7MgGQ12Z7Qab0qlWQ/Qqz24Gc6BM0thvEMVjHnfYGF0rmFCozFSxQBxwHKO" crossorigin="anonymous"></script>
    
    <script>
        async function downloadAllInvoices() {
            const modal = new bootstrap.Modal(document.getElementById('downloadModal'));
            const progressBar = document.getElementById('downloadProgress');
            const progressPercent = document.getElementById('downloadPercent');
            const status = document.getElementById('downloadStatus');
            const subtext = document.getElementById('downloadSubtext');
            const footer = document.getElementById('downloadFooter');
            
            // Reset modal state
            progressBar.style.width = '0%';
            progressPercent.textContent = '0%';
            status.textContent = 'Gathering your invoices...';
            subtext.textContent = 'This may take a few moments depending on the number of invoices.';
            footer.style.display = 'none';
            
            // Show modal
            modal.show();
            
            // Simulate progress updates
            let progress = 0;
            const progressInterval = setInterval(() => {
                progress += Math.random() * 15;
                if (progress > 90) progress = 90;
                
                progressBar.style.width = progress + '%';
                progressPercent.textContent = Math.round(progress) + '%';
                
                if (progress > 30 && progress < 60) {
                    status.textContent = 'Downloading invoice PDFs...';
                } else if (progress >= 60 && progress < 90) {
                    status.textContent = 'Creating ZIP archive...';
                }
            }, 500);
            
            try {
                // Trigger download
                const response = await fetch('/download-all-invoices', {
                    method: 'GET',
                    credentials: 'same-origin'
                });
                
                if (!response.ok) {
                    const errorData = await response.json();
                    throw new Error(errorData.error || 'Download failed');
                }
                
                // Complete progress
                clearInterval(progressInterval);
                progressBar.style.width = '100%';
                progressPercent.textContent = '100%';
                status.textContent = 'Download complete!';
                subtext.textContent = 'Your invoice archive is being downloaded...';
                
                // Download the file
                const blob = await response.blob();
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                
                // Extract filename from response headers
                const contentDisposition = response.headers.get('Content-Disposition');
                let filename = 'invoices.zip';
                if (contentDisposition) {
                    const filenameMatch = contentDisposition.match(/filename="(.+)"/);
                    if (filenameMatch) {
                        filename = filenameMatch[1];
                    }
                }
                
                a.download = filename;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                window.URL.revokeObjectURL(url);
                
                // Show success state
                setTimeout(() => {
                    // Hide spinner
                    const spinnerContainer = document.querySelector('.spinner-border').parentElement;
                    spinnerContainer.style.display = 'none';
                    
                    status.innerHTML = '<i class="bi bi-check-circle-fill text-success me-2"></i>Download Complete!';
                    subtext.textContent = 'Your invoice archive has been downloaded successfully.';
                    footer.style.display = 'block';
                }, 1000);
                
            } catch (error) {
                clearInterval(progressInterval);
                console.error('Download error:', error);
                
                // Hide spinner
                const spinnerContainer = document.querySelector('.spinner-border').parentElement;
                spinnerContainer.style.display = 'none';
                
                // Show error state
                progressBar.classList.remove('bg-primary');
                progressBar.classList.add('bg-danger');
                status.innerHTML = '<i class="bi bi-exclamation-triangle-fill text-danger me-2"></i>Download Failed';
                subtext.textContent = error.message || 'An error occurred while preparing your download. Please try again.';
                footer.style.display = 'block';
            }
        }
    </script>
</body>
</html> 