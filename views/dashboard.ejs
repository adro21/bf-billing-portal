<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Billing Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-4Q6Gf2aSP4eDXB8Miphtr37CMZZQ5oXLH2yaXMJ2w8e2ZtHTl7GptT4jmndRuHDT" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="bg-slate-50 d-flex flex-column min-vh-100">
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" href="#">
                <i class="bi bi-receipt-cutoff me-2 text-slate-600"></i>
                Billing Portal
            </a>
            <div class="navbar-nav ms-auto">
                <div class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="d-flex align-items-center">
                            <div class="bg-slate-100 rounded-circle p-1 me-2">
                                <i class="bi bi-person text-slate-600"></i>
                            </div>
                            <span class="text-slate-700"><%= email %></span>
                        </div>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><h6 class="dropdown-header text-slate-600">Account</h6></li>
                        <li><span class="dropdown-item-text small text-slate-500"><%= email %></span></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-red-600 d-flex align-items-center" href="/logout">
                            <i class="bi bi-box-arrow-right me-2"></i>
                            Logout
                        </a></li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="container my-5 flex-grow-1">
        <!-- Header -->
        <div class="mb-5">
            <h1 class="h3 fw-bold text-slate-900 mb-1">Billing Overview</h1>
            <p class="text-slate-500 mb-0">Manage your subscription and view invoice history</p>
        </div>

        <!-- Error Alert -->
        <% if (error) { %>
            <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <div><%= error %></div>
            </div>
        <% } %>

        <!-- Account Overview Section -->
        <% if (!error && customer) { %>
            <div class="row mb-5">
                <!-- Current Plan/Subscription -->
                <% if (subscriptions && subscriptions.length > 0) { %>
                    <div class="col-md-6 mb-4">
                        <div class="card rounded-4 shadow-tailwind h-100">
                            <div class="card-header bg-white border-bottom rounded-top-4">
                                <h5 class="mb-0 text-slate-900 fw-semibold d-flex align-items-center">
                                    <i class="bi bi-layers me-2 text-slate-600"></i>
                                    Current Plan
                                </h5>
                            </div>
                            <div class="card-body">
                                <% subscriptions.forEach(function(subscription) { %>
                                    <div class="<%= subscriptions.indexOf(subscription) !== subscriptions.length - 1 ? 'mb-4 pb-3 border-bottom' : '' %>">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div>
                                                <h6 class="fw-bold text-slate-900 mb-1">
                                                    <%= subscription.items.data[0].price.product.name %>
                                                </h6>
                                                <p class="text-slate-600 mb-2">
                                                    <%= (subscription.items.data[0].price.unit_amount / 100).toLocaleString('en-US', { 
                                                        style: 'currency', 
                                                        currency: subscription.items.data[0].price.currency.toUpperCase() 
                                                    }) %>
                                                    / <%= subscription.items.data[0].price.recurring.interval %>
                                                </p>
                                            </div>
                                            <span class="badge <%= subscription.status === 'active' ? 'bg-success' : subscription.status === 'canceled' ? 'bg-danger' : subscription.status === 'past_due' ? 'bg-warning text-dark' : 'bg-secondary' %> rounded-pill">
                                                <%= subscription.status.charAt(0).toUpperCase() + subscription.status.slice(1) %>
                                            </span>
                                        </div>
                                        <div class="small text-slate-500">
                                            <div class="mb-1">
                                                <strong>Current period:</strong> 
                                                <%= new Date(subscription.current_period_start * 1000).toLocaleDateString('en-US') %> - 
                                                <%= new Date(subscription.current_period_end * 1000).toLocaleDateString('en-US') %>
                                            </div>
                                            <% if (subscription.status === 'active') { %>
                                                <div>
                                                    <strong>Next billing:</strong> 
                                                    <%= new Date(subscription.current_period_end * 1000).toLocaleDateString('en-US', { 
                                                        year: 'numeric', 
                                                        month: 'long', 
                                                        day: 'numeric' 
                                                    }) %>
                                                </div>
                                            <% } else if (subscription.status === 'canceled' && subscription.canceled_at) { %>
                                                <div>
                                                    <strong>Canceled:</strong> 
                                                    <%= new Date(subscription.canceled_at * 1000).toLocaleDateString('en-US', { 
                                                        year: 'numeric', 
                                                        month: 'long', 
                                                        day: 'numeric' 
                                                    }) %>
                                                </div>
                                            <% } %>
                                        </div>
                                    </div>
                                <% }); %>
                            </div>
                        </div>
                    </div>
                <% } %>

                <!-- Upcoming Invoice or Payment Methods -->
                <div class="col-md-6 mb-4">
                    <% if (upcomingInvoice) { %>
                        <!-- Upcoming Invoice -->
                        <div class="card rounded-4 shadow-tailwind h-100">
                            <div class="card-header bg-white border-bottom rounded-top-4">
                                <h5 class="mb-0 text-slate-900 fw-semibold d-flex align-items-center">
                                    <i class="bi bi-calendar-event me-2 text-slate-600"></i>
                                    Next Invoice
                                </h5>
                            </div>
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <h6 class="fw-bold text-slate-900 mb-1">
                                            <%= (upcomingInvoice.amount_due / 100).toLocaleString('en-US', { 
                                                style: 'currency', 
                                                currency: upcomingInvoice.currency.toUpperCase() 
                                            }) %>
                                        </h6>
                                        <p class="text-slate-600 mb-0">
                                            Due <%= new Date(upcomingInvoice.period_end * 1000).toLocaleDateString('en-US', { 
                                                year: 'numeric', 
                                                month: 'long', 
                                                day: 'numeric' 
                                            }) %>
                                        </p>
                                    </div>
                                    <span class="badge bg-blue-100 text-blue-700 rounded-pill">Upcoming</span>
                                </div>
                                <% if (upcomingInvoice.lines && upcomingInvoice.lines.data.length > 0) { %>
                                    <div class="small text-slate-500">
                                        <% upcomingInvoice.lines.data.forEach(function(line) { %>
                                            <div><%= line.description %></div>
                                        <% }); %>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    <% } else if (paymentMethods && paymentMethods.length > 0) { %>
                        <!-- Payment Methods -->
                        <div class="card rounded-4 shadow-tailwind h-100">
                            <div class="card-header bg-white border-bottom rounded-top-4">
                                <h5 class="mb-0 text-slate-900 fw-semibold d-flex align-items-center">
                                    <i class="bi bi-credit-card me-2 text-slate-600"></i>
                                    Payment Methods
                                </h5>
                            </div>
                            <div class="card-body">
                                <% paymentMethods.forEach(function(pm) { %>
                                    <div class="d-flex align-items-center <%= paymentMethods.indexOf(pm) !== paymentMethods.length - 1 ? 'mb-3' : '' %>">
                                        <div class="me-3">
                                            <i class="bi bi-credit-card-2-front text-slate-400" style="font-size: 1.5rem;"></i>
                                        </div>
                                        <div class="flex-grow-1">
                                            <div class="fw-semibold text-slate-900">
                                                **** **** **** <%= pm.card.last4 %>
                                            </div>
                                            <div class="small text-slate-500">
                                                <%= pm.card.brand.charAt(0).toUpperCase() + pm.card.brand.slice(1) %> • 
                                                Expires <%= pm.card.exp_month %>/<%= pm.card.exp_year %>
                                            </div>
                                        </div>
                                    </div>
                                <% }); %>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- Quick Actions -->
            <% if (customerPortalUrl) { %>
                <div class="row mb-5">
                    <div class="col-12">
                        <div class="card rounded-4 shadow-tailwind bg-gradient-to-r from-blue-50 to-indigo-50 border-blue-200">
                            <div class="card-body text-center py-4">
                                <h6 class="fw-semibold text-slate-900 mb-2">
                                    <i class="bi bi-gear me-2"></i>
                                    Manage Your Account
                                </h6>
                                <p class="text-slate-600 mb-3">Update payment methods, billing address, download invoices, or modify your subscription</p>
                                <a href="<%= customerPortalUrl %>" class="btn btn-primary">
                                    <i class="bi bi-box-arrow-up-right me-2"></i>
                                    Open Customer Portal
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            <% } %>
        <% } %>

        <!-- Invoices Section -->
        <% if (invoices && invoices.length > 0) { %>
            <!-- Invoice List -->
            <div class="card rounded-4 shadow-tailwind">
                <div class="card-header bg-white border-bottom rounded-top-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="mb-0 text-slate-900 fw-semibold">Recent Invoices</h5>
                            <small class="text-slate-500">Your billing history and receipts</small>
                        </div>
                        <span class="badge bg-slate-100 text-slate-700 rounded-pill">
                            <%= invoices.length %> invoice<%= invoices.length !== 1 ? 's' : '' %>
                        </span>
                    </div>
                </div>

                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        <% invoices.forEach(function(invoice, index) { %>
                            <div class="list-group-item border-0 <%= index !== invoices.length - 1 ? 'border-bottom' : '' %> py-4 <%= index === invoices.length - 1 ? 'rounded-bottom-4' : '' %> invoice-item">
                                <!-- Desktop Layout -->
                                <div class="d-none d-md-block">
                                    <div class="row align-items-center">
                                        <div class="col-md-1">
                                            <div class="status-indicator <%= invoice.status %>"></div>
                                        </div>
                                        
                                        <div class="col-md-3">
                                            <div class="d-flex flex-column">
                                                <span class="fw-semibold text-slate-900">
                                                    <%= (invoice.amount_paid / 100).toLocaleString('en-US', { 
                                                        style: 'currency', 
                                                        currency: invoice.currency.toUpperCase() 
                                                    }) %>
                                                </span>
                                                <% if (invoice.number) { %>
                                                    <small class="text-slate-500">Invoice #<%= invoice.number %></small>
                                                <% } %>
                                            </div>
                                        </div>
                                        
                                        <div class="col-md-4">
                                            <div class="d-flex flex-column">
                                                <span class="text-slate-700 fw-medium">
                                                    <%= new Date(invoice.created * 1000).toLocaleDateString('en-US', { 
                                                        year: 'numeric', 
                                                        month: 'short', 
                                                        day: 'numeric' 
                                                    }) %>
                                                </span>
                                                <% if (invoice.description) { %>
                                                    <small class="text-slate-500">
                                                        <%= invoice.description.length > 50 ? invoice.description.substring(0, 50) + '...' : invoice.description %>
                                                    </small>
                                                <% } else { %>
                                                    <small class="text-slate-400">No description</small>
                                                <% } %>
                                            </div>
                                        </div>
                                        
                                        <div class="col-md-2">
                                            <span class="badge <%= invoice.status === 'paid' ? 'bg-success' : invoice.status === 'open' ? 'bg-warning text-dark' : 'bg-secondary' %> rounded-pill">
                                                <%= invoice.status.charAt(0).toUpperCase() + invoice.status.slice(1) %>
                                            </span>
                                        </div>
                                        
                                        <div class="col-md-2 text-end">
                                            <% if (invoice.hosted_invoice_url) { %>
                                                <a href="<%= invoice.hosted_invoice_url %>" 
                                                   target="_blank" 
                                                   rel="noopener noreferrer"
                                                   class="btn btn-outline-primary btn-sm">
                                                    <i class="bi bi-download me-1"></i>
                                                    PDF
                                                </a>
                                            <% } else { %>
                                                <button class="btn btn-outline-secondary btn-sm" disabled>
                                                    <i class="bi bi-file-x me-1"></i>
                                                    N/A
                                                </button>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>

                                <!-- Mobile Layout -->
                                <div class="d-block d-md-none">
                                    <div class="mobile-invoice-card">
                                        <!-- Top Section: Status and Amount -->
                                        <div class="mobile-header">
                                            <div class="mobile-status-row">
                                                <div class="status-indicator <%= invoice.status %>"></div>
                                                <span class="mobile-status-text">
                                                    <%= invoice.status.charAt(0).toUpperCase() + invoice.status.slice(1) %>
                                                </span>
                                            </div>
                                            <div class="mobile-amount-display">
                                                <%= (invoice.amount_paid / 100).toLocaleString('en-US', { 
                                                    style: 'currency', 
                                                    currency: invoice.currency.toUpperCase() 
                                                }) %>
                                            </div>
                                        </div>

                                        <!-- Invoice Details -->
                                        <div class="mobile-details-section">
                                            <% if (invoice.number) { %>
                                                <div class="mobile-detail-row">
                                                    <span class="mobile-label">Invoice</span>
                                                    <span class="mobile-value">#<%= invoice.number %></span>
                                                </div>
                                            <% } %>
                                            
                                            <div class="mobile-detail-row">
                                                <span class="mobile-label">Date</span>
                                                <span class="mobile-value">
                                                    <%= new Date(invoice.created * 1000).toLocaleDateString('en-US', { 
                                                        year: 'numeric', 
                                                        month: 'short', 
                                                        day: 'numeric' 
                                                    }) %>
                                                </span>
                                            </div>
                                            
                                            <% if (invoice.description) { %>
                                                <div class="mobile-detail-row">
                                                    <span class="mobile-label">Description</span>
                                                    <span class="mobile-value mobile-description">
                                                        <%= invoice.description %>
                                                    </span>
                                                </div>
                                            <% } %>
                                        </div>

                                        <!-- Action Button -->
                                        <div class="mobile-action-section">
                                            <% if (invoice.hosted_invoice_url) { %>
                                                <a href="<%= invoice.hosted_invoice_url %>" 
                                                   target="_blank" 
                                                   rel="noopener noreferrer"
                                                   class="mobile-download-btn">
                                                    <i class="bi bi-download"></i>
                                                    Download PDF
                                                </a>
                                            <% } else { %>
                                                <button class="mobile-download-btn mobile-disabled" disabled>
                                                    <i class="bi bi-file-x"></i>
                                                    Not Available
                                                </button>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                </div>
            </div>
        <% } else if (!error) { %>
            <!-- Empty State -->
            <div class="text-center py-5">
                <div class="card border-0 shadow-tailwind rounded-4">
                    <div class="card-body empty-state">
                        <i class="bi bi-inbox"></i>
                        <h4 class="text-slate-700 mb-3">No invoices found</h4>
                        <p class="text-slate-500 mb-4">We couldn't find any billing history for <strong><%= email %></strong></p>
                        
                        <div class="alert alert-info border-0 bg-blue-50 text-start d-inline-block">
                            <h6 class="fw-semibold text-blue-700 mb-2">This could mean:</h6>
                            <ul class="mb-0 ps-3 text-blue-600">
                                <li>You haven't made any purchases yet</li>
                                <li>Your billing email differs from your login email</li>
                                <li>Your account isn't set up in our billing system yet</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        <% } %>
    </div>

    <!-- Footer -->
    <footer class="mt-auto py-4 bg-white border-top">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <p class="mb-0 text-slate-500">&copy; 2025 Bounce Forward Co. Secure billing portal powered by Stripe.</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <div class="d-flex align-items-center justify-content-md-end">
                        <i class="bi bi-shield-check me-2 text-slate-400"></i>
                        <small class="text-slate-500">Secure • Private • Encrypted</small>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js" integrity="sha384-j1CDi7MgGQ12Z7Qab0qlWQ/Qqz24Gc6BM0thvEMVjHnfYGF0rmFCozFSxQBxwHKO" crossorigin="anonymous"></script>
</body>
</html> 