<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Billing Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-4Q6Gf2aSP4eDXB8Miphtr37CMZZQ5oXLH2yaXMJ2w8e2ZtHTl7GptT4jmndRuHDT" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="bg-slate-50">
    <div class="container-fluid vh-100 d-flex align-items-center justify-content-center">
        <div class="row w-100 justify-content-center">
            <div class="col-md-6 col-lg-4">
                <div class="card border-0 shadow-tailwind">
                    <div class="card-body p-5">
                        <div class="text-center mb-5">
                            <div class="mb-3">
                                <i class="bi bi-receipt-cutoff text-slate-400" style="font-size: 2.5rem;"></i>
                            </div>
                            <h1 class="h4 fw-bold text-slate-900 mb-2">Access Your Billing History</h1>
                            <p class="text-slate-500 mb-0">Enter your email address to receive a secure login link</p>
                        </div>

                        <% if (error) { %>
                            <div class="alert alert-danger border-0 d-flex align-items-start mb-4" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-2 mt-1 flex-shrink-0"></i>
                                <div>
                                    <strong>Error:</strong> <%= error %>
                                </div>
                            </div>
                        <% } %>

                        <% if (message) { %>
                            <div class="alert alert-success border-0 d-flex align-items-start mb-4" role="alert">
                                <i class="bi bi-check-circle-fill me-2 mt-1 flex-shrink-0"></i>
                                <div><%= message %></div>
                            </div>
                        <% } %>

                        <form action="/send-magic-link" method="POST">
                            <div class="mb-4">
                                <label for="email" class="form-label text-slate-700 fw-medium mb-2">Email Address</label>
                                <input 
                                    type="email" 
                                    id="email" 
                                    name="email" 
                                    required 
                                    placeholder="your.email@company.com"
                                    class="form-control form-control-lg focus-ring"
                                    style="padding: 0.75rem 1rem;"
                                >
                            </div>
                            <button type="submit" class="btn btn-primary w-100 py-3 fw-medium mb-4">
                                Send Magic Link
                            </button>
                        </form>

                        <div class="bg-slate-100 rounded-3 p-4">
                            <div class="d-flex align-items-start">
                                <div class="bg-green-50 rounded-circle p-2 me-3 flex-shrink-0">
                                    <i class="bi bi-shield-check text-green-600"></i>
                                </div>
                                <div>
                                    <h6 class="fw-semibold text-slate-800 mb-2">Secure Access</h6>
                                    <ul class="small text-slate-600 mb-0 ps-3">
                                        <li>No passwords required</li>
                                        <li>Links expire in 15 minutes</li>
                                        <li>Only you can access your billing data</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="position-fixed bottom-0 w-100 bg-white border-top py-3">
        <div class="container text-center">
            <small class="text-slate-500">&copy; 2024 MySaaS. Secure billing portal powered by Stripe.</small>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js" integrity="sha384-j1CDi7MgGQ12Z7Qab0qlWQ/Qqz24Gc6BM0thvEMVjHnfYGF0rmFCozFSxQBxwHKO" crossorigin="anonymous"></script>
</body>
</html> 