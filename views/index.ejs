<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Billing Portal</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <div class="login-container">
        <div class="login-card">
            <h1>Access Your Billing History</h1>
            <p class="login-subtitle">Enter your email address to receive a secure login link</p>

            <% if (error) { %>
                <div class="alert alert-error">
                    <strong>Error:</strong> <%= error %>
                </div>
            <% } %>

            <% if (message) { %>
                <div class="alert alert-success">
                    <%= message %>
                </div>
            <% } %>

            <form action="/send-magic-link" method="POST" class="login-form">
                <div class="form-group">
                    <label for="email">Email Address</label>
                    <input 
                        type="email" 
                        id="email" 
                        name="email" 
                        required 
                        placeholder="your.email@company.com"
                        class="form-input"
                    >
                </div>
                <button type="submit" class="btn btn-primary">Send Magic Link</button>
            </form>

            <div class="security-note">
                <h3>🔐 Secure Access</h3>
                <ul>
                    <li>No passwords required</li>
                    <li>Links expire in 15 minutes</li>
                    <li>Only you can access your billing data</li>
                </ul>
            </div>
        </div>
    </div>

    <footer class="footer">
        <div class="container">
            <p>&copy; 2024 MySaaS. Secure billing portal powered by Stripe.</p>
        </div>
    </footer>
</body>
</html> 