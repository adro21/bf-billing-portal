<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - Bounce Forward Billing</title>
    <link rel="icon" type="image/jpeg" href="/images/favicon.jpg">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-4Q6Gf2aSP4eDXB8Miphtr37CMZZQ5oXLH2yaXMJ2w8e2ZtHTl7GptT4jmndRuHDT" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="bg-super-light-pink d-flex flex-column min-vh-100">
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" href="/admin">
                <img src="/images/logo.png" 
                     alt="Bounce Forward Logo" 
                     class="me-2"
                     style="height: 40px; width: auto;">
            </a>
            <div class="navbar-nav ms-auto">
                <div class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="d-flex align-items-center">
                            <div class="bg-red-600 rounded-circle p-1 me-2">
                                <i class="bi bi-person-badge text-white"></i>
                            </div>
                            <span class="text-slate-700">Admin Portal</span>
                        </div>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><h6 class="dropdown-header text-slate-600">Admin Access</h6></li>
                        <li><span class="dropdown-item-text small text-slate-500">Authorized Personnel Only</span></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-red-600 d-flex align-items-center" href="/admin/logout">
                            <i class="bi bi-box-arrow-right me-2"></i>
                            Logout
                        </a></li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="container my-5 flex-grow-1">
        <!-- Header -->
        <div class="mb-5 text-center">
            <h1 class="h3 fw-bold text-slate-900 mb-1">Customer Account Access</h1>
            <p class="text-slate-500 mb-0">Search for customers and view their billing dashboards</p>
        </div>

        <!-- Search Section -->
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card border-0 shadow-tailwind rounded-4">
                    <div class="card-body p-4 p-md-5">
                        <div class="text-center mb-4">
                            <div class="bg-blue-50 rounded-circle p-3 d-inline-flex mb-3">
                                <i class="bi bi-search text-blue-600" style="font-size: 1.5rem;"></i>
                            </div>
                            <h5 class="fw-bold text-slate-900 mb-2">Customer Lookup</h5>
                            <p class="text-slate-500 mb-0">Enter a customer's email address to access their billing dashboard</p>
                        </div>

                        <% if (error) { %>
                            <div class="alert alert-danger border-0 d-flex mb-4" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-2 flex-shrink-0"></i>
                                <div><%= error %></div>
                            </div>
                        <% } %>

                        <% if (message) { %>
                            <div class="alert alert-success border-0 d-flex mb-4" role="alert">
                                <i class="bi bi-check-circle-fill me-2 flex-shrink-0"></i>
                                <div><%= message %></div>
                            </div>
                        <% } %>

                        <form action="/admin/lookup" method="POST">
                            <div class="mb-4">
                                <label for="customerEmail" class="form-label text-slate-700 fw-medium mb-2">Customer Email Address</label>
                                <input 
                                    type="email" 
                                    id="customerEmail" 
                                    name="customerEmail" 
                                    required 
                                    placeholder="customer@example.com"
                                    class="form-control form-control-lg focus-ring"
                                    style="padding: 0.75rem 1rem;"
                                    value="<%= searchEmail || '' %>"
                                >
                            </div>
                            <button type="submit" class="btn btn-primary w-100 py-3 fw-medium">
                                <i class="bi bi-search me-2"></i>
                                Search & Access Dashboard
                            </button>
                        </form>

                        <% if (customers && customers.length > 0) { %>
                            <!-- Customers Found -->
                            <div class="mt-5 pt-4 border-top">
                                <% customers.forEach(function(customer, index) { %>
                                    <div class="<%= index > 0 ? 'mt-4' : '' %>">
                                        <div class="bg-white rounded-3 p-4 border border-slate-200 shadow-sm">
                                            <!-- Header with Title and Badges -->
                                            <div class="d-flex justify-content-between align-items-start mb-4">
                                                <div>
                                                    <div class="d-flex align-items-center gap-2 mb-2">
                                                        <h6 class="fw-bold text-slate-900 mb-0">
                                                            <% if (customers.length > 1) { %>
                                                                Customer <%= index + 1 %> of <%= customers.length %>
                                                            <% } else { %>
                                                                Customer Found
                                                            <% } %>
                                                        </h6>
                                                        <% if (index === 0 && customers.length > 1) { %>
                                                            <span class="badge bg-primary text-white rounded-pill" style="font-size: 0.7rem;">
                                                                <i class="bi bi-star-fill me-1"></i>Recommended
                                                            </span>
                                                        <% } %>
                                                    </div>
                                                    <p class="text-slate-600 mb-0" style="font-size: 0.9rem;">
                                                        <%= customer.summary.activeSubscriptions > 0 ? 'Has active subscriptions' : 
                                                            customer.summary.paidInvoices > 0 ? 'Has billing history' : 
                                                            'Limited activity' %>
                                                    </p>
                                                </div>
                                                <div class="d-flex align-items-center gap-2">
                                                    <% if (customer.summary.activeSubscriptions > 0) { %>
                                                        <span class="badge bg-success text-white rounded-pill px-3 py-2">
                                                            <i class="bi bi-check-circle me-1"></i>Active
                                                        </span>
                                                    <% } else if (customer.summary.paidInvoices > 0) { %>
                                                        <span class="badge bg-info text-white rounded-pill px-3 py-2">
                                                            <i class="bi bi-clock-history me-1"></i>Past Customer
                                                        </span>
                                                    <% } else { %>
                                                        <span class="badge bg-secondary text-white rounded-pill px-3 py-2">
                                                            <i class="bi bi-dash-circle me-1"></i>Limited Activity
                                                        </span>
                                                    <% } %>
                                                </div>
                                            </div>
                                            
                                            <!-- Customer Details Grid -->
                                            <div class="row g-3 mb-4">
                                                <div class="col-md-6">
                                                    <div class="bg-slate-50 rounded-2 p-3">
                                                        <div class="d-flex align-items-center mb-2">
                                                            <i class="bi bi-envelope text-slate-500 me-2"></i>
                                                            <span class="text-slate-600 fw-medium" style="font-size: 0.85rem;">Email Address</span>
                                                        </div>
                                                        <div class="text-slate-900 fw-medium"><%= customer.email %></div>
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="bg-slate-50 rounded-2 p-3">
                                                        <div class="d-flex align-items-center mb-2">
                                                            <i class="bi bi-hash text-slate-500 me-2"></i>
                                                            <span class="text-slate-600 fw-medium" style="font-size: 0.85rem;">Customer ID</span>
                                                        </div>
                                                        <div class="text-slate-900 font-monospace" style="font-size: 0.9rem;"><%= customer.id %></div>
                                                    </div>
                                                </div>
                                                <% if (customer.name) { %>
                                                    <div class="col-md-6">
                                                        <div class="bg-slate-50 rounded-2 p-3">
                                                            <div class="d-flex align-items-center mb-2">
                                                                <i class="bi bi-person text-slate-500 me-2"></i>
                                                                <span class="text-slate-600 fw-medium" style="font-size: 0.85rem;">Name</span>
                                                            </div>
                                                            <div class="text-slate-900 fw-medium"><%= customer.name %></div>
                                                        </div>
                                                    </div>
                                                <% } %>
                                                <div class="col-md-6">
                                                    <div class="bg-slate-50 rounded-2 p-3">
                                                        <div class="d-flex align-items-center mb-2">
                                                            <i class="bi bi-calendar-plus text-slate-500 me-2"></i>
                                                            <span class="text-slate-600 fw-medium" style="font-size: 0.85rem;">Created</span>
                                                        </div>
                                                        <div class="text-slate-900 fw-medium">
                                                            <%= new Date(customer.created * 1000).toLocaleDateString('en-US', { 
                                                                year: 'numeric', 
                                                                month: 'short', 
                                                                day: 'numeric' 
                                                            }) %>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Activity Summary - Improved Layout -->
                                            <div class="mb-4">
                                                <div class="bg-gradient-to-r from-blue-50 to-indigo-50 rounded-3 p-4 border border-blue-100">
                                                    <div class="d-flex align-items-center mb-3">
                                                        <div class="bg-blue-100 rounded-circle p-2 me-3">
                                                            <i class="bi bi-graph-up text-blue-600"></i>
                                                        </div>
                                                        <h6 class="text-slate-800 fw-bold mb-0">Activity Overview</h6>
                                                    </div>
                                                    
                                                    <div class="row g-3">
                                                        <div class="col-6 col-lg-3">
                                                            <div class="bg-white rounded-2 p-3 text-center border border-slate-100 h-100 d-flex flex-column justify-content-center">
                                                                <div class="text-primary fw-bold mb-1" style="font-size: 1.25rem; line-height: 1.2;">
                                                                    <%= customer.summary.activeSubscriptions %>
                                                                </div>
                                                                <div class="text-slate-600 fw-medium" style="font-size: 0.8rem; line-height: 1.3;">
                                                                    Active Subscriptions
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-6 col-lg-3">
                                                            <div class="bg-white rounded-2 p-3 text-center border border-slate-100 h-100 d-flex flex-column justify-content-center">
                                                                <div class="text-success fw-bold mb-1" style="font-size: 1.25rem; line-height: 1.2;">
                                                                    <%= customer.summary.paidInvoices %>
                                                                </div>
                                                                <div class="text-slate-600 fw-medium" style="font-size: 0.8rem; line-height: 1.3;">
                                                                    Paid Invoices
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-6 col-lg-3">
                                                            <div class="bg-white rounded-2 p-3 text-center border border-slate-100 h-100 d-flex flex-column justify-content-center">
                                                                <div class="text-dark-pink fw-bold mb-1" style="font-size: 1.25rem; line-height: 1.2;">
                                                                    <%= (customer.summary.totalPaid / 100).toLocaleString('en-US', { 
                                                                        style: 'currency', 
                                                                        currency: 'USD',
                                                                        minimumFractionDigits: 0,
                                                                        maximumFractionDigits: 0
                                                                    }) %>
                                                                </div>
                                                                <div class="text-slate-600 fw-medium" style="font-size: 0.8rem; line-height: 1.3;">
                                                                    Total Revenue
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-6 col-lg-3">
                                                            <div class="bg-white rounded-2 p-3 text-center border border-slate-100 h-100 d-flex flex-column justify-content-center">
                                                                <div class="text-slate-700 fw-bold mb-1" style="font-size: 1.25rem; line-height: 1.2;">
                                                                    <% if (customer.summary.lastInvoiceDate) { %>
                                                                        <%= new Date(customer.summary.lastInvoiceDate * 1000).toLocaleDateString('en-US', { month: 'short', year: '2-digit' }) %>
                                                                    <% } else { %>
                                                                        —
                                                                    <% } %>
                                                                </div>
                                                                <div class="text-slate-600 fw-medium" style="font-size: 0.8rem; line-height: 1.3;">
                                                                    Last Invoice
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Action Button -->
                                            <div class="d-flex justify-content-end">
                                                <a href="/admin/view-customer/<%= customer.id %>" class="btn btn-primary d-flex align-items-center px-4 py-2">
                                                    <i class="bi bi-eye me-2"></i>
                                                    View Billing Dashboard
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                <% }); %>
                            </div>
                        <% } %>

                        <div class="text-center border-top pt-4 mt-4">
                            <div class="d-flex align-items-center justify-content-center mb-3">
                                <i class="bi bi-shield-lock text-slate-400 me-2" style="font-size: 1rem;"></i>
                                <span class="fw-medium text-slate-600" style="font-size: 0.9rem;">Secure Access</span>
                            </div>
                            <div class="text-slate-500" style="font-size: 0.85rem; line-height: 1.4;">
                                All access is logged for security • Customer privacy is protected
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="mt-auto py-4 bg-white border-top">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <p class="mb-0 text-slate-500">&copy; <%= new Date().getFullYear() %> Bounce Forward Co.</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <div class="d-flex align-items-center justify-content-md-end">
                        <i class="bi bi-person-badge me-2 text-slate-400"></i>
                        <small class="text-slate-500">Admin Portal • Authorized Access Only</small>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js" integrity="sha384-j1CDi7MgGQ12Z7Qab0qlWQ/Qqz24Gc6BM0thvEMVjHnfYGF0rmFCozFSxQBxwHKO" crossorigin="anonymous"></script>
</body>
</html> 