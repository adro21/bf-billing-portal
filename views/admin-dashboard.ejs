<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - Bounce Forward Billing</title>
    <link rel="icon" type="image/jpeg" href="/images/favicon.jpg">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-4Q6Gf2aSP4eDXB8Miphtr37CMZZQ5oXLH2yaXMJ2w8e2ZtHTl7GptT4jmndRuHDT" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="bg-super-light-pink d-flex flex-column min-vh-100">
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" href="/admin">
                <img src="/images/logo.png" 
                     alt="Bounce Forward Logo" 
                     class="me-2"
                     style="height: 40px; width: auto;">
            </a>
            <div class="navbar-nav ms-auto">
                <div class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="d-flex align-items-center">
                            <div class="bg-red-600 rounded-circle p-1 me-2">
                                <i class="bi bi-person-badge text-white"></i>
                            </div>
                            <span class="text-slate-700">Admin Portal</span>
                        </div>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><h6 class="dropdown-header text-slate-600">Admin Access</h6></li>
                        <li><span class="dropdown-item-text small text-slate-500">Authorized Personnel Only</span></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-red-600 d-flex align-items-center" href="/admin/logout">
                            <i class="bi bi-box-arrow-right me-2"></i>
                            Logout
                        </a></li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="container my-5 flex-grow-1">
        <!-- Header -->
        <div class="mb-5 text-center">
            <h1 class="h3 fw-bold text-slate-900 mb-1">Customer Account Access</h1>
            <p class="text-slate-500 mb-0">Search for customers and view their billing dashboards</p>
        </div>

        <!-- Search Section -->
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card border-0 shadow-tailwind rounded-4">
                    <div class="card-body p-4 p-md-5">
                        <div class="text-center mb-4">
                            <div class="bg-blue-50 rounded-circle p-3 d-inline-flex mb-3">
                                <i class="bi bi-search text-blue-600" style="font-size: 1.5rem;"></i>
                            </div>
                            <h5 class="fw-bold text-slate-900 mb-2">Customer Lookup</h5>
                            <p class="text-slate-500 mb-0">Enter a customer's email address to access their billing dashboard</p>
                        </div>

                        <% if (error) { %>
                            <div class="alert alert-danger border-0 d-flex mb-4" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-2 flex-shrink-0"></i>
                                <div><%= error %></div>
                            </div>
                        <% } %>

                        <% if (message) { %>
                            <div class="alert alert-success border-0 d-flex mb-4" role="alert">
                                <i class="bi bi-check-circle-fill me-2 flex-shrink-0"></i>
                                <div><%= message %></div>
                            </div>
                        <% } %>

                        <form action="/admin/lookup" method="POST">
                            <div class="mb-4">
                                <label for="customerEmail" class="form-label text-slate-700 fw-medium mb-2">Customer Email Address</label>
                                <input 
                                    type="email" 
                                    id="customerEmail" 
                                    name="customerEmail" 
                                    required 
                                    placeholder="customer@example.com"
                                    class="form-control form-control-lg focus-ring"
                                    style="padding: 0.75rem 1rem;"
                                    value="<%= searchEmail || '' %>"
                                >
                            </div>
                            <button type="submit" class="btn btn-primary w-100 py-3 fw-medium">
                                <i class="bi bi-search me-2"></i>
                                Search & Access Dashboard
                            </button>
                        </form>

                        <% if (customer) { %>
                            <!-- Customer Found -->
                            <div class="mt-5 pt-4 border-top">
                                <div class="bg-green-50 rounded-3 p-4">
                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <div>
                                            <div class="d-flex align-items-center mb-1">
                                                <div class="bg-green-500 rounded-circle p-1 me-2" style="width: 1.5rem; height: 1.5rem;">
                                                    <i class="bi bi-person-check text-white" style="font-size: 0.75rem;"></i>
                                                </div>
                                                <h6 class="fw-bold text-green-800 mb-0">Customer Found</h6>
                                            </div>
                                            <small class="text-green-600">Ready to access billing dashboard</small>
                                        </div>
                                        <span class="badge bg-success rounded-pill">Active</span>
                                    </div>
                                    
                                    <div class="row g-3 mb-4">
                                        <div class="col-md-6">
                                            <div class="d-flex flex-column">
                                                <span class="text-green-700 fw-bold">Email</span>
                                                <span class="text-green-800"><%= customer.email %></span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="d-flex flex-column">
                                                <span class="text-green-700 fw-bold">Customer ID</span>
                                                <span class="text-green-800 font-monospace small"><%= customer.id %></span>
                                            </div>
                                        </div>
                                        <% if (customer.name) { %>
                                            <div class="col-md-6">
                                                <div class="d-flex flex-column">
                                                    <span class="text-green-700 fw-bold">Name</span>
                                                    <span class="text-green-800"><%= customer.name %></span>
                                                </div>
                                            </div>
                                        <% } %>
                                        <div class="col-md-6">
                                            <div class="d-flex flex-column">
                                                <span class="text-green-700 fw-bold">Created</span>
                                                <span class="text-green-800">
                                                    <%= new Date(customer.created * 1000).toLocaleDateString('en-US', { 
                                                        year: 'numeric', 
                                                        month: 'long', 
                                                        day: 'numeric' 
                                                    }) %>
                                                </span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                        <a href="/admin/view-customer/<%= customer.id %>" class="btn btn-success d-flex align-items-center">
                                            <i class="bi bi-eye me-2"></i>
                                            View Billing Dashboard
                                        </a>
                                    </div>
                                </div>
                            </div>
                        <% } %>

                        <div class="text-center border-top pt-4 mt-4">
                            <div class="d-flex align-items-center justify-content-center mb-3">
                                <i class="bi bi-shield-lock text-slate-400 me-2" style="font-size: 1rem;"></i>
                                <span class="fw-medium text-slate-600" style="font-size: 0.9rem;">Secure Access</span>
                            </div>
                            <div class="text-slate-500" style="font-size: 0.85rem; line-height: 1.4;">
                                All access is logged for security • Customer privacy is protected
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="mt-auto py-4 bg-white border-top">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <p class="mb-0 text-slate-500">&copy; <%= new Date().getFullYear() %> Bounce Forward Co.</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <div class="d-flex align-items-center justify-content-md-end">
                        <i class="bi bi-person-badge me-2 text-slate-400"></i>
                        <small class="text-slate-500">Admin Portal • Authorized Access Only</small>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js" integrity="sha384-j1CDi7MgGQ12Z7Qab0qlWQ/Qqz24Gc6BM0thvEMVjHnfYGF0rmFCozFSxQBxwHKO" crossorigin="anonymous"></script>
</body>
</html> 