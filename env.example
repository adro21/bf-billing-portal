# Environment Configuration
NODE_ENV=development

# SendGrid API Key for sending magic link emails
SENDGRID_API_KEY=your_sendgrid_api_key_here

# JWT Secret for signing and verifying tokens (use a long random string)
JWT_SECRET=your_very_long_random_jwt_secret_here

# Stripe Secret Key 
# DEVELOPMENT: Use test key (sk_test_...)
# PRODUCTION: Use live key (sk_live_...)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Base URL for magic links
# DEVELOPMENT: http://localhost:3000
# PRODUCTION: https://yourdomain.com
BASE_URL=http://localhost:3000

# Verified sender email address for SendGrid
SENDER_EMAIL=billing@mysaas.com

# Port for the application (optional, defaults to 3000)
PORT=3000 

# Admin Test Route Configuration (LEGACY - Consider disabling in favor of new Admin Portal)
# This is the old URL-based admin system: /admin-test?secret=X&customerId=Y
# RECOMMENDED: Set ADMIN_TEST_ENABLED=false and use the new Admin Portal instead
ADMIN_TEST_ENABLED=false
ADMIN_TEST_SECRET=your_admin_secret_token_here_min_32_chars

# Admin Portal Configuration (RECOMMENDED - New secure admin interface)
# Password for accessing the user-friendly admin portal (minimum 12 characters)
# Access via: /admin (much more secure than the legacy admin test route)
ADMIN_PASSWORD=your_secure_admin_password_min_12_chars 